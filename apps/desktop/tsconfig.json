{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@lingui/core/macro": ["./src/i18n/shim/coreMacro.ts"],
      "@lingui/react/macro": ["./src/i18n/shim/reactMacro.tsx"],
      "@lingui/core": ["./src/i18n/shim/core.ts"],
      "@lingui/react": ["./src/i18n/shim/react.tsx"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
