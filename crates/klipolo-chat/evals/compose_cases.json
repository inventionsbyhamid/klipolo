{
  "source": "The planner's eval of edits composed from the general tools rather than fixed styles, on project_compose_a.json: clip A (NASA's space station Q&A, 155 s) played whole, landscape, with a title \"Space station Q&A\" (t1, 0 to 4 s), the logo over the whole video (i1), a rocket sticker (i2, 20 to 25 s) and lofi-beat.mp3 as music at 50% that doesn't duck (m1); clip A's transcript, speaker turns and Spark scene log come from tests/fixtures. Each case passes when one of its `expect` alternatives matches the first answer, as cases.json says; `{has}` wants a list holding a match for each item given, in any order among others, and `{allOf}` each of several rules. A slow push-in on the main footage has no tool yet (no keys on the main track or on zoom layers), so that case wants cannotDo or a question; lowering the music while someone talks, or for a stretch, wants its volume keys. Run it with --cases.",
  "project": "project_compose_a.json",
  "asset": "clip-a",
  "transcript": "../tests/fixtures/transcript_clip_a.json",
  "turns": "../tests/fixtures/turns_clip_a.json",
  "scenes": "../tests/fixtures/scenes_clip_a.json",
  "pack": "../../../assets/library/manifest.json",
  "cases": [
    {
      "id": "slide-title-overshoot",
      "message": "slide the title in from the left with a little overshoot",
      "expect": [
        {
          "calls": [{"name": "setMotion", "args": {"layer": "t1", "keys": {"has": [
            {"property": "x", "value": {"max": -0.05}},
            {"property": "x", "value": {"min": -0.02, "max": 0.02}, "ease": {"anyOf": [{"contains": "spring"}, {"contains": "cubic"}]}}
          ]}}}],
          "outcome": {"applied": true}
        },
        {
          "calls": [{"name": "setMotion", "args": {"layer": "t1", "presets": {"allOf": [{"contains": "slide left"}, {"anyOf": [{"contains": "spring"}, {"contains": "cubic"}]}]}}}],
          "outcome": {"applied": true}
        }
      ]
    },
    {
      "id": "logo-spin-bounce",
      "message": "make the logo spin in and bounce",
      "expect": [
        {
          "calls": [{"name": "setMotion", "args": {"layer": "i1", "keys": {"has": [
            {"property": "rotation", "value": {"min": -0.5, "max": 0.5}},
            {"ease": {"anyOf": [{"contains": "spring"}, {"contains": "cubic"}]}}
          ]}}}],
          "outcome": {"applied": true}
        },
        {
          "calls": [{"name": "setMotion", "args": {"layer": "i1", "keys": {"has": [{"property": "rotation"}]}, "presets": {"contains": "bounce"}}}],
          "outcome": {"applied": true}
        }
      ]
    },
    {
      "id": "word-pop",
      "message": "make each word pop in one by one",
      "expect": [
        {
          "calls": [{"name": "animateText", "args": {"layer": "t1", "set": {"has": [
            {"key": "by", "value": "word"},
            {"key": {"anyOf": ["scale", "opacity"]}}
          ]}}}],
          "outcome": {"applied": true}
        }
      ]
    },
    {
      "id": "slow-zoom-speaker",
      "message": "slowly zoom into the speaker over five seconds",
      "expect": [
        {"calls": [{"name": "cannotDo"}]},
        {"calls": [{"name": "askUser"}], "outcome": {"asked": true}}
      ]
    },
    {
      "id": "music-down-talking",
      "message": "fade the music down while I'm talking",
      "expect": [
        {
          "calls": [{"name": "setLayer", "args": {"layer": "m1", "volumeKeys": {"allOf": [{"minItems": 2}, {"has": [{"value": {"max": 0.35}}]}]}}}],
          "outcome": {"applied": true}
        }
      ]
    },
    {
      "id": "duck-music-stretch",
      "message": "duck the music between 0:10 and 0:20",
      "expect": [
        {
          "calls": [{"name": "setLayer", "args": {"layer": "m1", "volumeKeys": {"has": [
            {"atSec": {"min": 10.0, "max": 20.0}, "value": {"max": 0.35}},
            {"atSec": {"min": 19.5, "max": 23.0}, "value": {"min": 0.4}}
          ]}}}],
          "outcome": {"applied": true}
        }
      ]
    },
    {
      "id": "sticker-float",
      "message": "make the sticker float up and down gently",
      "expect": [
        {
          "calls": [{"name": "setMotion", "args": {"layer": "i2", "presets": {"contains": "loop float"}}}],
          "outcome": {"applied": true}
        },
        {
          "calls": [{"name": "setMotion", "args": {"layer": "i2", "keys": {"has": [{"property": "y"}]}}}],
          "outcome": {"applied": true}
        }
      ]
    },
    {
      "id": "title-yellow-outline",
      "message": "make the title yellow with a black outline",
      "expect": [
        {
          "calls": [{"name": "styleText", "args": {"layer": "t1", "set": {"has": [{"key": "color"}, {"key": "outline", "value": {"anyOf": ["#000000", "#000000FF"]}}]}}}],
          "outcome": {"applied": true}
        },
        {
          "calls": [{"name": "styleText", "args": {"layer": "t1", "set": {"has": [{"key": "look", "value": "pop"}]}}}],
          "outcome": {"applied": true}
        }
      ]
    },
    {
      "id": "logo-corner",
      "message": "put the logo in the top right corner and make it a bit see-through",
      "expect": [
        {
          "calls": [{"name": "setLayer", "args": {"layer": "i1", "set": {"has": [{"key": "box"}, {"key": "opacity", "value": {"min": 0.3, "max": 0.95}}]}}}],
          "outcome": {"applied": true}
        }
      ]
    },
    {
      "id": "soft-vignette",
      "message": "add a soft vignette to the video",
      "expect": [
        {
          "calls": [{"name": "setEffects", "args": {"target": "c1", "name": "vignette"}}],
          "outcome": {"applied": true}
        }
      ]
    }
  ]
}
