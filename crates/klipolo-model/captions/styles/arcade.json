{
  "schema": 1,
  "id": "klipolo.builtin/caption.arcade",
  "name": "Arcade",
  "font": { "family": "Anton", "weight": 400, "italic": false },
  "fallbacks": [{ "script": "Cyrl", "family": "Oswald", "weight": 700, "italic": false }],
  "case": "upper",
  "punctuation": "questionAndExclamation",
  "size": { "portrait": 120, "landscape": 92 },
  "autofitMin": 0.8,
  "letterSpacingEm": 0.02,
  "lineHeight": 1.0,
  "charEm": 0.42,
  "fill": "#FFFFFF",
  "accent": "#00F0FF",
  "swatches": ["#00F0FF", "#39FF14", "#FF2BD6", "#FFE500"],
  "outline": { "color": "#0B0B12", "widthEm": 0.09 },
  "shadow": null,
  "boxes": null,
  "pages": { "reveal": "page", "maxWords": 3, "maxLines": 2, "maxLineWidth": { "portrait": 0.66, "landscape": 0.50 },
             "breakSilenceMs": 250, "minPageMs": 300, "maxPageMs": 1500, "lingerMs": 250 },
  "position": { "portrait": { "y": 0.58, "seam": true }, "landscape": { "y": 0.80 } },
  "active": { "color": { "color": "accent", "fadeMs": 60 }, "scale": 1.08,
              "glow": { "color": "accent", "blurEm": 0.35, "alpha": 0.7 } },
  "keyword": { "words": "gaming", "color": "#39FF14", "gain": "#39FF14", "loss": "#FF2BD6", "scale": 1.2 },
  "enter": { "per": "page", "motion": { "kind": "slam", "ms": 110, "from": 1.35 } },
  "tiltDeg": 0,
  "shake": { "ampEm": 0.015, "ms": 80, "keywordPagesOnly": true },
  "exit": { "kind": "cut" },
  "leadMs": 50,
  "variants": []
}
