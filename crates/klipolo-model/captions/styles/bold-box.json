{
  "schema": 1,
  "id": "klipolo.builtin/caption.bold-box",
  "name": "Bold box",
  "font": { "family": "Montserrat", "weight": 900, "italic": false },
  "fallbacks": [],
  "case": "upper",
  "punctuation": "questionAndExclamation",
  "size": { "portrait": 80, "landscape": 64 },
  "autofitMin": 0.8,
  "letterSpacingEm": 0,
  "lineHeight": 1.22,
  "charEm": 0.66,
  "fill": "#FFFFFF",
  "accent": "#FFFFFF",
  "swatches": ["#FFFFFF", "#000000", "#F7C204", "#FF2E5B", "#39E508", "#2F80FF"],
  "outline": null,
  "shadow": { "color": "#000000", "alpha": 0.35, "dxEm": 0, "dyEm": 0.05, "blurEm": 0.12 },
  "boxes": { "on": "line", "color": "accent", "alpha": 1.0, "padXEm": 0.24, "padYEm": 0.10, "radiusEm": 0.30,
             "glideMs": 0, "growMs": 0 },
  "pages": { "reveal": "page", "maxWords": 3, "maxLines": 2, "maxLineWidth": { "portrait": 0.72, "landscape": 0.60 },
             "breakSilenceMs": 350, "minPageMs": 500, "maxPageMs": 2200, "lingerMs": 200 },
  "position": { "portrait": { "y": 0.62 }, "landscape": { "y": 0.80 } },
  "active": {},
  "keyword": null,
  "enter": { "per": "page", "motion": { "kind": "pop", "ms": 140, "from": 0.8, "peak": 1.05, "dyEm": 0 } },
  "tiltDeg": 0,
  "shake": null,
  "exit": { "kind": "cut" },
  "leadMs": 50,
  "variants": [
    { "key": "dark", "name": "Dark", "accent": "#000000" },
    { "key": "yellow", "name": "Yellow", "accent": "#F7C204" }
  ]
}
