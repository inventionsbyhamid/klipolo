{
  "schema": 1,
  "id": "klipolo.builtin/caption.clean",
  "name": "Clean",
  "font": { "family": "Inter", "weight": 600, "italic": false },
  "fallbacks": [],
  "case": "asSaid",
  "punctuation": "keep",
  "size": { "portrait": 60, "landscape": 52 },
  "autofitMin": 0.85,
  "letterSpacingEm": -0.005,
  "lineHeight": 1.22,
  "charEm": 0.51,
  "fill": "accent",
  "accent": "#FFFFFF",
  "swatches": ["#FFFFFF", "#FFD60A", "#F2CD46"],
  "outline": null,
  "shadow": { "color": "#000000", "alpha": 0.75, "dxEm": 0, "dyEm": 0.04, "blurEm": 0.14 },
  "boxes": null,
  "pages": { "reveal": "page", "maxLines": 2, "maxLineWidth": { "portrait": 0.72, "landscape": 0.80 },
             "maxChars": { "portrait": 28, "landscape": 42 },
             "breakSilenceMs": 500, "minPageMs": 833, "maxPageMs": 7000, "lingerMs": 200, "readingCps": 20 },
  "position": { "portrait": { "y": 0.68 }, "landscape": { "y": 0.88 } },
  "active": {},
  "keyword": null,
  "enter": { "per": "page", "motion": { "kind": "fade", "ms": 120 } },
  "tiltDeg": 0,
  "shake": null,
  "exit": { "kind": "fade", "ms": 80, "minGapMs": 100 },
  "leadMs": 50,
  "variants": [
    { "key": "plate", "name": "Plate",
      "boxes": { "on": "line", "color": "#000000", "alpha": 0.55, "padXEm": 0.25, "padYEm": 0.10, "radiusEm": 0.12,
                 "glideMs": 0, "growMs": 0, "text": "accent" } },
    { "key": "outlined", "name": "Outlined", "outline": { "color": "#000000", "widthEm": 0.04 } }
  ]
}
