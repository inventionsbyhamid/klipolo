{
  "schema": 1,
  "id": "klipolo.builtin/caption.highlight",
  "name": "Highlight",
  "font": { "family": "TikTok Sans", "weight": 800, "italic": false },
  "fallbacks": [],
  "case": "upper",
  "punctuation": "questionAndExclamation",
  "size": { "portrait": 88, "landscape": 68 },
  "autofitMin": 0.85,
  "letterSpacingEm": 0.01,
  "lineHeight": 1.18,
  "charEm": 0.62,
  "fill": "#FFFFFF",
  "accent": "#FF2E5B",
  "swatches": ["#FF2E5B", "#B8FF3C", "#7C4DFF", "#FFD60A", "#2F80FF"],
  "outline": { "color": "#000000", "widthEm": 0.04 },
  "shadow": { "color": "#000000", "alpha": 0.45, "dxEm": 0, "dyEm": 0.06, "blurEm": 0.18 },
  "boxes": { "on": "activeWord", "color": "accent", "alpha": 1.0, "padXEm": 0.16, "padYEm": 0.08, "radiusEm": 0.18,
             "glideMs": 100, "growMs": 150 },
  "pages": { "reveal": "page", "maxWords": 4, "maxLines": 2, "maxLineWidth": { "portrait": 0.70, "landscape": 0.70 },
             "breakSilenceMs": 350, "minPageMs": 600, "maxPageMs": 2500, "lingerMs": 200 },
  "position": { "portrait": { "y": 0.62 }, "landscape": { "y": 0.82 } },
  "active": { "scale": 1.04 },
  "keyword": null,
  "enter": { "per": "page", "motion": { "kind": "pop", "ms": 150, "from": 0.9, "peak": 1.02, "dyEm": 0 } },
  "tiltDeg": 0,
  "shake": null,
  "exit": { "kind": "fade", "ms": 100, "minGapMs": 0 },
  "leadMs": 50,
  "variants": []
}
