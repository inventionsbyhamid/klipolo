{
  "schema": 1,
  "id": "klipolo.builtin/caption.karaoke",
  "name": "Karaoke",
  "font": { "family": "TikTok Sans", "weight": 800, "italic": false },
  "fallbacks": [],
  "case": "asSaid",
  "punctuation": "keep",
  "size": { "portrait": 78, "landscape": 60 },
  "autofitMin": 0.85,
  "letterSpacingEm": 0,
  "lineHeight": 1.12,
  "charEm": 0.52,
  "fill": "#FFFFFF",
  "accent": "#FFD400",
  "swatches": ["#FFD400", "#39E508", "#2F80FF", "#FF2E5B", "#FFFFFF"],
  "outline": { "color": "#000000", "widthEm": 0.07 },
  "shadow": { "color": "#000000", "alpha": 0.6, "dxEm": 0, "dyEm": 0.04, "blurEm": 0.10 },
  "boxes": null,
  "pages": { "reveal": "page", "maxWords": 8, "maxLines": 2, "maxLineWidth": { "portrait": 0.70, "landscape": 0.70 },
             "maxChars": { "portrait": 42, "landscape": 42 },
             "breakSilenceMs": 500, "minPageMs": 1000, "maxPageMs": 4000, "lingerMs": 200 },
  "position": { "portrait": { "y": 0.64 }, "landscape": { "y": 0.85 } },
  "active": { "color": { "color": "accent", "fadeMs": 80 }, "dimUpcoming": 0.55 },
  "keyword": null,
  "enter": { "per": "page", "motion": { "kind": "fade", "ms": 100 } },
  "tiltDeg": 0,
  "shake": null,
  "exit": { "kind": "fade", "ms": 60, "minGapMs": 300 },
  "leadMs": 50,
  "variants": []
}
