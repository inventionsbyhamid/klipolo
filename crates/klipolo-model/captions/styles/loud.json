{
  "schema": 1,
  "id": "klipolo.builtin/caption.loud",
  "name": "Loud",
  "font": { "family": "Bangers", "weight": 400, "italic": false },
  "fallbacks": [{ "script": "Cyrl", "family": "Rubik", "weight": 900, "italic": true }],
  "case": "upper",
  "punctuation": "questionAndExclamation",
  "size": { "portrait": 130, "landscape": 100 },
  "autofitMin": 0.7,
  "letterSpacingEm": 0.02,
  "lineHeight": 1.0,
  "charEm": 0.38,
  "fill": "#FFFFFF",
  "accent": "#FFE500",
  "swatches": ["#FFE500", "#3DFF5C", "#FF3030", "#2F80FF", "#FFFFFF"],
  "outline": { "color": "#000000", "widthEm": 0.14 },
  "shadow": { "color": "#000000", "alpha": 1.0, "dxEm": 0.03, "dyEm": 0.08, "blurEm": 0 },
  "boxes": null,
  "pages": { "reveal": "page", "maxWords": 2, "maxLines": 1, "maxLineWidth": { "portrait": 0.75, "landscape": 0.60 },
             "breakSilenceMs": 250, "minPageMs": 250, "maxPageMs": 1200, "lingerMs": 250 },
  "position": { "portrait": { "y": 0.56 }, "landscape": { "y": 0.72 } },
  "active": { "scale": 1.06 },
  "keyword": { "words": "power", "color": "accent", "gain": "#3DFF5C", "loss": "#FF3030", "scale": 1.15,
               "glow": { "blurEm": 0.30, "alpha": 0.5 } },
  "enter": { "per": "page", "motion": { "kind": "pop", "ms": 180, "from": 0.5, "peak": 1.15, "dyEm": 0 } },
  "tiltDeg": 3,
  "shake": null,
  "exit": { "kind": "cut" },
  "leadMs": 50,
  "variants": []
}
