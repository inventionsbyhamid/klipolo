{
  "scene": 1,
  "duration": 4,
  "segments": { "in": 1.2, "out": 0.6 },
  "params": [
    { "key": "title", "label": "Title", "type": "text", "default": "Your name", "maxLen": 40 },
    { "key": "role", "label": "Role", "type": "text", "default": "Your role", "maxLen": 60 },
    { "key": "accent", "label": "Accent", "type": "color", "default": "#FFB000" }
  ],
  "nodes": [
    {
      "id": "card",
      "type": "group",
      "box": [0.04, 0.62, 0.6, 0.26],
      "children": [
        {
          "id": "tab",
          "type": "rect",
          "box": [0, 0, 0.012, 1],
          "fill": "$accent",
          "radius": 3,
          "origin": "50% 100%",
          "animate": { "scaleY": [{ "t": 0, "v": 0 }, { "t": 0.4, "v": 1, "ease": "power3.out" }] }
        },
        {
          "id": "name",
          "class": "line",
          "type": "text",
          "text": "$title",
          "box": [0.05, 0, 0.95, 0.6],
          "font": "Inter",
          "size": 64,
          "weight": 700,
          "fill": "#FFFFFF",
          "split": "words",
          "stagger": { "each": 0.05 },
          "fit": "shrink",
          "animate": {
            "x": [{ "t": 0.2, "v": -40, "unit": "px" }, { "t": 0.6, "v": 0, "ease": "power2.out", "unit": "px" }]
          }
        },
        {
          "id": "role",
          "class": "line",
          "type": "text",
          "text": "$role",
          "box": [0.05, 0.62, 0.95, 0.38],
          "font": { "family": "Montserrat", "source": { "type": "bundled" }, "weight": 500 },
          "size": 36,
          "fill": "rgba(255, 255, 255, 0.8)"
        },
        {
          "id": "rule",
          "type": "path",
          "d": "M0 0 L300 0",
          "box": [0.05, 0.6, 0.9, 0],
          "stroke": "$accent",
          "strokeWidth": 4,
          "cap": "round",
          "animate": { "trim.end": [{ "t": 0.3, "v": 0 }, { "t": 0.9, "v": 1, "ease": "power2.inOut" }] }
        }
      ]
    }
  ],
  "timeline": [
    { "set": "#card", "clip": "inset(0 100% 0 0)" },
    { "to": "#card", "at": 0.1, "dur": 0.55, "ease": "power3.out", "clip": "inset(0 0% 0 0)" },
    { "from": ".line", "at": 0.34, "dur": 0.5, "ease": "power3.out", "y": "22px", "opacity": 0, "stagger": 0.1 },
    { "to": "#card", "at": "out", "dur": 0.35, "ease": "power2.in", "y": "18px", "opacity": 0 }
  ]
}
